{
  "manifest_version": 3,
  "name": "SENTINEL",
  "version": "1.0.0",
  "description": "Personal Digital Identity Firewall",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_title": "SENTINEL",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}